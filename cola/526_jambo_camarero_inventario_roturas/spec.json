, {"w": "que", "s": 3.88, "e": 4.02}, {"w": "viene", "s": 4.02, "e": 4.24}], "offset": 0.05, "tail": 0.12}, "shot": "medio", "texts": [], "overlays": [{"id": "84af1400", "type": "emoji", "text": "😤", "x": 0.18, "y": 0.32, "start": 0.25, "size": 0.12}]}, {"id": "a5f9c537", "duration": 6.699999999999999, "transition": "slide", "background": {"type": "set", "set": "salon", "hour": 16, "night": false}, "characters": [{"who": "felipe", "x": 0.3, "expr": "enfadado"}], "voice": {"text": "¿Yo? ¡Si fue este, joder! El mismo que pinchó la luz para sus tomates. Que lo resuelva el Neo.", "provider": "edge", "speaker": "felipe", "url": "/tmp/jb/526_7.mp3", "duration": 6.35, "words": [{"w": "Yo", "s": 0.48, "e": 0.64}, {"w": "Si", "s": 0.98, "e": 1.16}, {"w": "fue", "s": 1.16, "e": 1.38}, {"w": "este", "s": 1.38, "e": 1.72}, {"w": "joder", "s": 1.72, "e": 2.22}, {"w": "El", "s": 2.54, "e": 3.14}, {"w": "mismo", "s": 3.14, "e": 3.34}, {"w": "que", "s": 3.34, "e": 3.48}, {"w": "pinchó", "s": 3.48, "e": 3.8}, {"w": "la", "s": 3.8, "e": 3.9}, {"w": "luz", "s": 3.9, "e": 4.04}, {"w": "para", "s": 4.04, "e": 4.22}, {"w": "sus", "s": 4.22, "e": 4.36}, {"w": "tomates", "s": 4.36, "e": 4.8}, {"w": "Que", "s": 5.26, "e": 5.44}, {"w": "lo", "s": 5.44, "e": 5.54}, {"w": "resuelva", "s": 5.54, "e": 5.92}, {"w": "el", "s": 5.92, "e": 6.0}, {"w": "Neo", "s": 6.0, "e": 6.24}], "offset": 0.05, "tail": 0.12}, "shot": "primerplano", "texts": [], "overlays": [{"id": "e8c3ba56", "type": "emoji", "text": "🤯", "x": 0.82, "y": 0.32, "start": 0.25, "size": 0.12}]}, {"id": "c2d7156d", "duration": 7.143, "transition": "flash", "background": {"type": "set", "set": "salon", "hour": 16, "night": false}, "characters": [{"who": "neo", "x": 0.72, "expr": "chulo", "intro": true}, {"who": "rosa", "x": 0.3, "expr": "sorprendido"}], "voice": {"text": "Resuelto. La rotura la causó el vecino, y hay testigo. Descontarla de otra nómina no es contabilidad, señora Melano. Es venganza.", "provider": "edge", "speaker": "neo