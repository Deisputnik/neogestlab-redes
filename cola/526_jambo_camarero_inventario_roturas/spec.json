": "felipe", "url": "/tmp/jb/526_1.mp3", "duration": 4.343, "words": [{"w": "Buah", "s": 0.03, "e": 0.54}, {"w": "Tranquila", "s": 0.54, "e": 1.1}, {"w": "jefa", "s": 1.1, "e": 1.4}, {"w": "Las", "s": 1.78, "e": 1.96}, {"w": "roturas", "s": 1.96, "e": 2.32}, {"w": "las", "s": 2.32, "e": 2.46}, {"w": "paga", "s": 2.46, "e": 2.68}, {"w": "Europa", "s": 2.74, "e": 2.92}, {"w": "Lo", "s": 2.92, "e": 3.22}, {"w": "sé", "s": 3.22, "e": 3.52}, {"w": "de", "s": 3.52, "e": 3.64}, {"w": "buena", "s": 3.64, "e": 3.84}, {"w": "tinta", "s": 3.84, "e": 4.14}], "offset": 0.05, "tail": 0.12}, "shot": "medio", "texts": [], "overlays": [{"id": "0317dda1", "type": "emoji", "text": "🤯", "x": 0.82, "y": 0.32, "start": 0.25, "size": 0.12}]}, {"id": "96dd9639", "duration": 4.505, "transition": "slide", "background": {"type": "set", "set": "salon", "hour": 16, "night": false}, "characters": [{"who": "sindy", "x": 0.72, "expr": "neutral", "intro": true}], "voice": {"text": "¿Que paga Europa? ¡Anda ya! ¿Y ese reguero de cerveza hasta el trastero, qué?", "provider": "edge", "speaker": "sindy", "url": "/tmp/jb/526_2.mp3", "duration": 4.155, "words": [{"w": "Que", "s": 0.03, "e": 0.12}, {"w": "paga", "s": 0.12, "e": 0.4}, {"w": "Europa", "s": 0.5, "e": 0.7}, {"w": "Anda", "s": 1.26, "e": 1.56}, {"w": "ya", "s": 1.56, "e": 1.66}, {"w": "Y", "s": 2.04, "e": 2.16}, {"w": "ese", "s": 2.16, "e": 2.32}, {"w": "reguero", "s": 2.32, "e": 2.64}, {"w": "de", "s": 2.64, "e": 2.74}, {"w": "cerveza", "s": 2.74, "e": 3.16}, {"w": "hasta", "s": 3.26, "e": 3.42}, {"w": "el", "s": 3.42, "e": 3.52}, {"w": "trastero", "s": 3.52, "e": 3.84}, {"w": "qué", "s": 3.84, "e": 4.0}], "offset": 0.05, "tail": 0.12}, "shot": "primerplano", "texts": [], "overlays": [{"id": "10b0cdd9", "type": "emoji", "text": "😱", "x": 0.18, "y": 0.32, "start": 0.25, "size": 0.12}]}, {"id": "e65037a7", "duration": 5.973999999999999, "transition": "slide", "background": {"type": "set", "set": "salon", "hour": 16, "night": false}, "characters": [{"who": "jambo", "x": 0.72, "expr": "neutral", "intro": true}], "voice": {"text": "Prima… válgame. Yo solo pasaba… ¿Qué te estaba diciendo?", "provider": "edge", "speaker": "jambo", "url": "/tmp/jb/526_3.mp3", "duration": 5.624, "words": [{"w": "Prima", "s": 0, "e": 0.34}, {"w": "válgame", "s": 1.1, "e": 1.72}, {"w": "Yo", "s": 2.12, "e": 2.46}, {"w": "solo", "s": 2.46, "e": 2.96}, {"w": "pasaba", "s": 2.96, "e": 3.6}, {"w": "Qué", "s": 4.28, "e": 4.78}, {"w": "te", "s": 4.78, "e": 4.9}, {"w": "estaba", "s": 4.9, "e": 5.16}, {"w": "diciendo", "s": 5.16, "e": 5.36}], "offset": 0.05, "tail": 0.12}, "shot": "auto", "texts": [], "overlays": [{"id": "b2b7ea6b", "type": "emoji", "text": "💸", "x": 0.18, "y": 0.32, "start": 0.25, "size": 0.12}]}, {"id": "103a6a61", "duration": 5.904, "transition": "slide", "background": {"type": "set", "set": "salon", "hour": 16, "night": false}, "characters": [{"who": "sindy", "x": 0.72, "expr": "enfadado"}, {"who": "jambo", "x": 0.3, "expr": "neutral"}], "voice": {"text": "¡Lo he visto yo, Rosa! El vecino se llevaba un barril a cuestas. ¡Tropezó y tumbó las tres cajas, hostia!", "provider": "edge", "speaker": "sindy", "url": "/tmp/jb/526_4.mp3", "duration": 5.554, "words": [{"w": "Lo", "s": 0, "e": 0.4}, {"w": "he", "s": 0.4, "e": 0.5}, {"w": "visto", "s": 0.5, "e": 0.74}, {"w": "yo", "s": 0.74, "e": 1.02}, {"w": "Rosa", "s": 1.3, "e": 1.5}, {"w": "El", "s": 1.96, "e": 2.18}, {"w": "vecino", "s": 2.18, "e": 2.54}, {"w": "se", "s": 2.54, "e": 2.68}, {"w": "llevaba", "s": 2.68, "e": 2.73}, {"w": "un", "s": 2.727, "e": 2.777}, {"w": "barril", "s": 2.773, "e": 2.823}, {"w": "a", "s": 2.82, "e": 2.94}, {"w": "cuestas", "s": 2.94, "e": 3.74}, {"w": "Tropezó", "s": 3.74, "e": 4.26}, {"w": "y", "s": 4.26, "e": 4.36}, {"w": "tumbó", "s": 4.36, "e": 4.66}, {"w": "las", "s": 4.66, "e": 4.78}, {"w": "tres", "s": 4.78, "e": 4.92}, {"w": "cajas", "s": 4.92, "e": 5.18}, {"w": "hostia", "s": 5.22, "e": 5.46}], "offset": 0.05, "tail": 0.12}, "shot": "g